environment        = "staging"
aws_region         = "eu-west-2"
domain_name        = "hrapp.co.uk"
ses_from_email     = "noreply@hrapp.co.uk"
ecr_repository_url = "123456789.dkr.ecr.eu-west-2.amazonaws.com/hrapp-backend"
image_tag          = "latest"
